
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function isSelf(id) {
      return signedIn() && me() == id;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function bk(id) {
      return get(/databases/$(db)/documents/bookings/$(id)).data;
    }

    function isParty(b) {
      return signedIn()
        && (b.renterId == me() || b.ownerId == me());
    }

    function validTransition(before, after) {
      let keys = after.diff(before).affectedKeys();

      // Phase 4: owner approves or declines a pending booking.
      let ownerDecision =
        before.status == 'pending'
        && after.status in ['approved', 'declined']
        && me() == before.ownerId
        && keys.hasOnly([
          'status', 'updatedAt'
        ]);

      // Phase 4: renter cancels a pending or approved booking.
      let renterCancellation =
        before.status in ['pending', 'approved']
        && after.status == 'cancelled'
        && me() == before.renterId
        && keys.hasOnly([
          'status', 'updatedAt'
        ]);

      // Phase 4: booking becomes confirmed.
      let confirmation =
        before.status == 'approved'
        && after.status == 'confirmed'
        && me() == before.renterId
        && keys.hasOnly([
          'status', 'updatedAt'
        ]);

      // Phase 5: second pickup confirmation activates booking.
      let pickup =
        before.status == 'confirmed'
        && after.status == 'active'
        && keys.hasOnly([
          'status',
          'ownerPickupConfirmedAt',
          'renterPickupConfirmedAt',
          'updatedAt'
        ]);

      // Phase 5: start return inspection.
      let startReturn =
        before.status == 'active'
        && after.status == 'return'
        && after.returnedAt != null
        && keys.hasOnly([
          'status', 'returnedAt', 'updatedAt'
        ]);

      // Phase 5: return confirmations and claim submission.
      let returnUpdate =
        before.status == 'return'
        && after.status in ['return', 'review']
        && keys.hasOnly([
          'status',
          'ownerReturnConfirmedAt',
          'renterReturnConfirmedAt',
          'cautionDecision',
          'lateDays',
          'lateFee',
          'lateFeeWaived',
          'updatedAt'
        ]);

      // Phase 5: settle caution after review.
      let settlement =
        before.status == 'review'
        && after.status == 'completed'
        && keys.hasOnly([
          'status',
          'cautionDecision',
          'renterOutcomeAckAt',
          'lateDays',
          'lateFee',
          'lateFeeWaived',
          'completedAt',
          'updatedAt'
        ]);

      return ownerDecision
        || renterCancellation
        || confirmation
        || pickup
        || startReturn
        || returnUpdate
        || settlement;
    }

    // ---------- P1: Users ----------
    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isSelf(uid)
        && request.resource.data.role in ['renter', 'owner']
        && request.resource.data.ratingCount == 0
        && request.resource.data.ratingAvg == 0
        && request.resource.data.completedCount == 0;

      allow update: if isSelf(uid)
        && !changed().hasAny([
          'role', 'verified', 'ratingAvg',
          'ratingCount', 'completedCount'
        ]);

      allow delete: if isSelf(uid);

      match /private/{doc} {
        allow read, write: if isSelf(uid);
      }

      match /favourites/{vid} {
        allow read, write: if isSelf(uid);
      }
    }

    // ---------- P2: Vehicles ----------
    match /vehicles/{vid} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerId == me();

      allow update, delete: if signedIn()
        && resource.data.ownerId == me();

      match /photos/{pid} {
        allow read: if signedIn();

        allow write: if signedIn()
          && get(/databases/$(db)/documents/vehicles/$(vid))
            .data.ownerId == me();
      }

      match /documents/{kind} {
        allow read, write: if signedIn()
          && get(/databases/$(db)/documents/vehicles/$(vid))
            .data.ownerId == me();
      }
    }

    // ---------- P3, P4, P5: Bookings ----------
    match /bookings/{id} {
      allow read: if isParty(resource.data);

      allow create: if signedIn()
        && request.resource.data.renterId == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.platformFee == 2000
        && request.resource.data.totalPayable
          == request.resource.data.rentalFee
          + request.resource.data.cautionFee
        && request.resource.data.ownerId ==
          get(/databases/$(db)/documents/vehicles/$(request.resource.data.vehicleId))
            .data.ownerId;

      allow update: if isParty(resource.data)
        && validTransition(resource.data, request.resource.data);

      allow delete: if isParty(resource.data);

      match /private/{side} {
        allow write: if signedIn()
          && (
            (side == 'renter' && bk(id).renterId == me())
            || (side == 'owner' && bk(id).ownerId == me())
          );

        allow read: if signedIn()
          && (
            (side == 'renter' && bk(id).renterId == me())
            || (side == 'owner' && bk(id).ownerId == me())
            || (
              isParty(bk(id))
              && bk(id).status in [
                'confirmed', 'active', 'return', 'review'
              ]
            )
          );
      }

      // Checklist entries and checklist media.
      match /{sub}/{docId} {
        allow read, write: if isParty(bk(id));
      }
    }

    // ---------- P4: Calendar and renter locks ----------
    match /calendarBlocks/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && isParty(bk(id));
    }

    match /renterLocks/{renterId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && renterId == bk(request.resource.data.bookingId).renterId
        && bk(request.resource.data.bookingId).ownerId == me();

      allow delete: if signedIn()
        && isParty(bk(resource.data.bookingId));
    }

    // ---------- P4/P5: Transactions ----------
    match /transactions/{tx} {
      allow read: if signedIn()
        && (
          resource.data.ownerId == me()
          || resource.data.renterId == me()
        );

      allow create: if signedIn()
        && isParty(bk(request.resource.data.bookingId))
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;

      allow update: if false;

      allow delete: if signedIn()
        && (
          resource.data.ownerId == me()
          || resource.data.renterId == me()
        );
    }

    // ---------- P5: Caution claims ----------
    match /cautionClaims/{bid} {
      allow read: if isParty(bk(bid));

      allow create: if signedIn()
        && bk(bid).ownerId == me()
        && request.resource.data.bookingId == bid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= bk(bid).cautionFee;

      allow update: if isParty(bk(bid))
        && request.resource.data.bookingId == bid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= bk(bid).cautionFee;

      allow delete: if false;
    }

    // ---------- P5: Repair expenses ----------
    match /repairExpenses/{id} {
      allow read: if signedIn()
        && resource.data.ownerId == me()
        && bk(resource.data.bookingId).ownerId == me();

      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && request.resource.data.bookingId is string
        && bk(request.resource.data.bookingId).ownerId == me()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.receiptUrl is string;

      allow update: if signedIn()
        && resource.data.ownerId == me()
        && bk(resource.data.bookingId).ownerId == me()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.bookingId == resource.data.bookingId
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.description is string
        && request.resource.data.receiptUrl is string;

      allow delete: if signedIn()
        && resource.data.ownerId == me()
        && bk(resource.data.bookingId).ownerId == me();
    }

    // ---------- P6: Reviews ----------
    match /reviews/{id} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.authorId == me();

      allow update: if signedIn()
        && resource.data.authorId == me()
        && !changed().hasAny([
          'authorId', 'bookingId',
          'subjectId', 'subjectType'
        ]);

      allow delete: if signedIn()
        && (
          resource.data.authorId == me()
          || resource.data.subjectId == me()
          || isParty(bk(resource.data.bookingId))
        );
    }

    // ---------- P6: Notifications ----------
    match /notifications/{id} {
      allow read, update, delete: if signedIn()
        && resource.data.userId == me();

      allow create: if signedIn();
    }

    // ---------- Audit logs ----------
    match /auditLogs/{id} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // ---------- Default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
