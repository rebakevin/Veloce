rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- helpers (Phase 0) ----------
    function signedIn()   { return request.auth != null; }
    function me()         { return request.auth.uid; }
    function isSelf(id)   { return signedIn() && me() == id; }
    function changed()    { return request.resource.data.diff(resource.data).affectedKeys(); }
    function bk(id)       { return get(/databases/$(db)/documents/bookings/$(id)).data; }
    function bkafter(id)  { return getAfter(/databases/$(db)/documents/bookings/$(id)).data; }
    function isParty(b)   { return signedIn() && (b.renterId == me() || b.ownerId == me()); }
    function hasReason()  { return request.resource.data.reason is string
                                   && request.resource.data.reason.size() > 0; }
    function serverUpdated() { return request.resource.data.updatedAt == request.time; }

    // Rows of the TECHNICAL.md §5.1 table, joined with `||`: Phase 4 first,
    // then Phase 5 (pickup, return, settlement).
    function validTransition(before, after) {
      // P4: pending/approved/confirmed transitions, locks, contact unlock.
      // P5: confirmed -> active, active -> return, return/review -> completed.
      return (
        before.status == 'pending' && after.status == 'approved'
        && before.ownerId == me()
        && serverUpdated()
        && changed().hasOnly(['status', 'payDeadline', 'updatedAt'])
      ) || (
        before.status == 'pending' && after.status == 'declined'
        && before.ownerId == me()
        && hasReason()
        && serverUpdated()
        && changed().hasOnly(['status', 'reason', 'updatedAt'])
      ) || (
        before.status == 'pending' && after.status == 'cancelled'
        && before.renterId == me()
        && serverUpdated()
        && changed().hasOnly(['status', 'reason', 'updatedAt'])
      ) || (
        before.status == 'pending' && after.status == 'expired'
        && isParty(before)
        && serverUpdated()
        && changed().hasOnly(['status', 'reason', 'updatedAt'])
      ) || (
        before.status == 'approved' && after.status == 'confirmed'
        && before.renterId == me()
        && serverUpdated()
        && changed().hasOnly(['status', 'updatedAt'])
      ) || (
        before.status == 'approved' && after.status == 'cancelled'
        && isParty(before)
        && serverUpdated()
        && changed().hasOnly(['status', 'reason', 'updatedAt'])
      ) || (
        before.status == 'approved' && after.status == 'expired'
        && isParty(before)
        && serverUpdated()
        && changed().hasOnly(['status', 'reason', 'updatedAt'])
      ) || (
        before.status == 'confirmed' && after.status == 'cancelled'
        && isParty(before)
        && serverUpdated()
        && changed().hasOnly(['status', 'reason', 'updatedAt'])
      ) || (
        before.renterId == me()
        && before.status == after.status
        && before.status in ['approved', 'confirmed']
        && after.agreementAckAt == request.time
        && serverUpdated()
        && changed().hasOnly(['agreementAckAt', 'updatedAt'])
      ) || (
        // P5: the first pickup confirmation; the booking stays confirmed.
        before.status == 'confirmed' && after.status == 'confirmed'
        && isParty(before)
        && changed().hasOnly(['ownerPickupConfirmedAt',
                              'renterPickupConfirmedAt', 'updatedAt'])
      ) || (
        // P5: the second pickup confirmation activates the booking.
        before.status == 'confirmed' && after.status == 'active'
        && isParty(before)
        && after.ownerPickupConfirmedAt != null
        && after.renterPickupConfirmedAt != null
        && changed().hasOnly(['status', 'ownerPickupConfirmedAt',
                              'renterPickupConfirmedAt', 'updatedAt'])
      ) || (
        // P5: start the return inspection.
        before.status == 'active' && after.status == 'return'
        && isParty(before)
        && after.returnedAt != null
        && changed().hasOnly(['status', 'returnedAt', 'updatedAt'])
      ) || (
        // P5: return confirmations, then the claim goes to review.
        before.status == 'return' && after.status in ['return', 'review']
        && isParty(before)
        && changed().hasOnly(['status', 'ownerReturnConfirmedAt',
                              'renterReturnConfirmedAt', 'cautionDecision',
                              'lateDays', 'lateFee', 'lateFeeWaived', 'updatedAt'])
      ) || (
        // P5: dispute or re-claim keeps the booking in review.
        before.status == 'review' && after.status == 'review'
        && isParty(before)
        && changed().hasOnly(['updatedAt'])
      ) || (
        // P5: settle the caution (from the return or review step).
        before.status in ['return', 'review'] && after.status == 'completed'
        && isParty(before)
        && changed().hasOnly(['status', 'cautionDecision', 'renterOutcomeAckAt',
                              'lateDays', 'lateFee', 'lateFeeWaived',
                              'completedAt', 'updatedAt'])
      );
    }

    // ---------- P1: users ----------
    match /users/{uid} {
      allow read:   if signedIn();                       // public profile fields only
      allow create: if isSelf(uid)
                    && request.resource.data.role in ['renter', 'owner']
                    && request.resource.data.ratingCount == 0
                    && request.resource.data.ratingAvg == 0
                    && request.resource.data.completedCount == 0;
      allow update: if isSelf(uid)
                    && !changed().hasAny(['role', 'verified', 'ratingAvg', 'ratingCount', 'completedCount']);
      allow delete: if isSelf(uid);                      // account deletion
      match /private/{doc}       { allow read, write: if isSelf(uid); }
      match /favourites/{vid}    { allow read, write: if isSelf(uid); }          // P3
    }

    // ---------- P2: vehicles ----------
    match /vehicles/{vid} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == me();
      allow update: if signedIn() && resource.data.ownerId == me()
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == me();
      match /photos/{pid} {
        allow read:  if signedIn();
        allow write: if signedIn()
                      && getAfter(/databases/$(db)/documents/vehicles/$(vid)).data.ownerId == me();
      }
      match /documents/{kind} {
        allow read, write: if signedIn()
                            && getAfter(/databases/$(db)/documents/vehicles/$(vid)).data.ownerId == me();
      }
    }

    // ---------- P3 create / P4, P5 transitions: bookings ----------
    match /bookings/{id} {
      allow read:   if isParty(resource.data);
      allow create: if signedIn() && request.resource.data.renterId == me()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.platformFee == 2000
                    && request.resource.data.totalPayable
                         == request.resource.data.rentalFee + request.resource.data.cautionFee
                    && request.resource.data.ownerId ==
                         get(/databases/$(db)/documents/vehicles/$(request.resource.data.vehicleId)).data.ownerId;
      allow update: if isParty(resource.data)
                    && validTransition(resource.data, request.resource.data);
      allow delete: if isParty(resource.data);              // account deletion

      match /private/{side} {
        allow write: if signedIn() && ((side == 'renter' && bkafter(id).renterId == me())
                                    || (side == 'owner'  && bkafter(id).ownerId  == me()));
        allow read:  if signedIn() && ((side == 'renter' && bk(id).renterId == me())
                                    || (side == 'owner'  && bk(id).ownerId  == me())
                                    || (isParty(bk(id))
                                        && bk(id).status in ['confirmed', 'active', 'return', 'review']));
      }
      // Listed by name: a `{sub}` wildcard would also match `private` and
      // expose each party's contact document to the other (rules are OR-ed).
      match /checklistEntries/{docId} {
        allow read, write: if isParty(bk(id));
      }
      match /checklistMedia/{docId} {
        allow read, write: if isParty(bk(id));
      }
    }

    // ---------- P4: calendar and renter locks ----------
    match /calendarBlocks/{id} {
      allow read:  if signedIn();
      allow create: if signedIn() && isParty(bkafter(id))
                    && bkafter(id).status in ['approved', 'confirmed'];
      allow update: if false;
      allow delete: if signedIn() && isParty(bk(id))
                    && bkafter(id).status in ['cancelled', 'expired', 'declined'];
    }
    match /renterLocks/{renterId} {
      allow read:   if signedIn();
      allow create: if signedIn()
                    && !exists(/databases/$(db)/documents/renterLocks/$(renterId))
                    && bkafter(request.resource.data.bookingId).ownerId == me()
                    && bkafter(request.resource.data.bookingId).renterId == renterId
                    && bkafter(request.resource.data.bookingId).status == 'approved';
      allow update: if false;
      allow delete: if signedIn() && isParty(bk(resource.data.bookingId))
                    && bkafter(resource.data.bookingId).status
                         in ['cancelled', 'expired', 'return', 'review', 'completed'];
    }

    // ---------- P4 / P5: ledger, claims, repairs ----------
    match /transactions/{tx} {
      allow read:   if signedIn() && (resource.data.ownerId == me() || resource.data.renterId == me());
      allow create: if signedIn()
                    && isParty(bk(request.resource.data.bookingId))
                    && request.resource.data.amount > 0
                    && request.resource.data.status == 'success'
                    && request.resource.data.at == request.time
                    && request.resource.data.ownerId
                         == bk(request.resource.data.bookingId).ownerId
                    && request.resource.data.renterId
                         == bk(request.resource.data.bookingId).renterId
                    && request.resource.data.vehicleId
                         == bk(request.resource.data.bookingId).vehicleId
                    && (
                      (
                        request.resource.data.type == 'charge'
                        && request.resource.data.fromParty == 'renter'
                        && request.resource.data.toParty == 'veloce'
                        && bk(request.resource.data.bookingId).renterId == me()
                        && bkafter(request.resource.data.bookingId).status == 'confirmed'
                        && request.resource.data.amount
                             == bkafter(request.resource.data.bookingId).totalPayable
                      ) || (
                        request.resource.data.type == 'refund'
                        && request.resource.data.fromParty == 'veloce'
                        && request.resource.data.toParty == 'renter'
                        && bkafter(request.resource.data.bookingId).status == 'cancelled'
                        && request.resource.data.amount
                             == bkafter(request.resource.data.bookingId).totalPayable
                      ) || (
                        // P5: rental fee released to the owner on pickup.
                        request.resource.data.type == 'release'
                        && request.resource.data.fromParty == 'veloce'
                        && request.resource.data.toParty == 'owner'
                        && bkafter(request.resource.data.bookingId).status == 'active'
                        && request.resource.data.amount
                             == bkafter(request.resource.data.bookingId).rentalFee
                      ) || (
                        request.resource.data.type == 'platform_fee'
                        && request.resource.data.fromParty == 'owner'
                        && request.resource.data.toParty == 'veloce'
                        && bkafter(request.resource.data.bookingId).status == 'active'
                        && request.resource.data.amount == 2000
                      ) || (
                        request.resource.data.type == 'payout'
                        && request.resource.data.fromParty == 'veloce'
                        && request.resource.data.toParty == 'owner'
                        && bkafter(request.resource.data.bookingId).status == 'active'
                        && request.resource.data.amount
                             == bkafter(request.resource.data.bookingId).rentalFee - 2000
                      ) || (
                        // P5: caution settlement.
                        request.resource.data.type in ['claim_deduction', 'late_fee']
                        && request.resource.data.fromParty == 'veloce'
                        && request.resource.data.toParty == 'owner'
                        && bkafter(request.resource.data.bookingId).status == 'completed'
                        && request.resource.data.amount
                             <= bk(request.resource.data.bookingId).cautionFee
                      ) || (
                        request.resource.data.type == 'refund'
                        && request.resource.data.fromParty == 'veloce'
                        && request.resource.data.toParty == 'renter'
                        && bkafter(request.resource.data.bookingId).status == 'completed'
                        && request.resource.data.amount
                             <= bk(request.resource.data.bookingId).cautionFee
                      )
                    );
      allow update: if false;                               // append-only
      allow delete: if signedIn()                           // account deletion only
                    && (resource.data.ownerId == me() || resource.data.renterId == me());
    }
    match /cautionClaims/{bid} {
      allow read: if isParty(bk(bid));
      allow create: if signedIn()
                    && bk(bid).ownerId == me()
                    && request.resource.data.bookingId == bid
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.amount <= bk(bid).cautionFee;
      allow update: if isParty(bk(bid))
                    && request.resource.data.bookingId == bid
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.amount <= bk(bid).cautionFee;
      allow delete: if false;
    }
    match /repairExpenses/{id} {
      allow read, delete: if signedIn() && resource.data.ownerId == me()
                          && bk(resource.data.bookingId).ownerId == me();
      allow create: if signedIn() && request.resource.data.ownerId == me()
                    && request.resource.data.bookingId is string
                    && bk(request.resource.data.bookingId).ownerId == me()
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.description is string
                    && request.resource.data.description.size() > 0
                    && request.resource.data.receiptUrl is string;
      allow update: if signedIn() && resource.data.ownerId == me()
                    && bk(resource.data.bookingId).ownerId == me()
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.bookingId == resource.data.bookingId
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.description is string
                    && request.resource.data.receiptUrl is string;
    }

    // ---------- P6: reviews and notifications ----------
    match /reviews/{id} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == me();
      allow update: if signedIn() && resource.data.authorId == me()
                    && !changed().hasAny(['authorId', 'bookingId', 'subjectId', 'subjectType']);
      // No delete button in the app. Only account deletion removes reviews: the
      // author's, and those received (the user, or a car through its booking).
      allow delete: if signedIn()
                    && (resource.data.authorId == me() || resource.data.subjectId == me()
                        || isParty(bk(resource.data.bookingId)));
    }
    match /notifications/{id} {
      allow read, update, delete: if signedIn() && resource.data.userId == me();
      allow create: if signedIn();                          // the writer is the other party
    }

    // ---------- audit (create-only) ----------
    match /auditLogs/{id} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }  // default deny
  }
}
